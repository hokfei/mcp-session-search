# Session Search MCP - configuration
#
# Copy to .env and edit, or set these as environment variables.
# All settings use the SESSION_SEARCH_ prefix.

# ==================== Storage ====================

# OpenCode's own session database. Read-only; we never write to it.
SESSION_SEARCH_OPENCODE_DB_PATH=~/.local/share/opencode/opencode.db

# Our search index. Contains embeddings and nothing else.
SESSION_SEARCH_DATABASE_PATH=~/.opencode/session_search.db

# ==================== Embedding model ====================

# Must be a sentence-embedding model. A generative chat model produces
# per-token states rather than one pooled vector, and cannot be used here.
SESSION_SEARCH_MODEL_PATH=~/models/bge-small-en-v1.5-q8_0.gguf

# bge-small is trained on 512-token passages; raising this beyond 512
# will not improve embeddings.
SESSION_SEARCH_MODEL_N_CTX=512

# 0 means CPU-only, which is fine for a 36 MB model.
SESSION_SEARCH_MODEL_N_GPU_LAYERS=0

# 0 auto-detects.
SESSION_SEARCH_MODEL_N_THREADS=0

# bge-small-en-v1.5 produces 384-dim vectors.
# Only change this if you swap models, then run rebuild_index.
SESSION_SEARCH_EMBEDDING_DIM=384

# ==================== Answer synthesis (optional) ====================

# Point at a GGUF chat model to get written answers instead of a plain
# listing of matches. Leave unset to skip loading a second model.
# SESSION_SEARCH_CHAT_MODEL_PATH=~/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
SESSION_SEARCH_CHAT_MODEL_N_CTX=2048
SESSION_SEARCH_MAX_SUMMARY_TOKENS=300

# ==================== Search ====================

SESSION_SEARCH_DEFAULT_TOP_K=5
SESSION_SEARCH_MAX_TOP_K=20

# Calibrated against this corpus: real matches score 0.60-0.85 at rank 1,
# unrelated questions top out near 0.535. Lower it to widen the net.
SESSION_SEARCH_SIMILARITY_THRESHOLD=0.55

# Index new or changed sessions automatically when searching.
SESSION_SEARCH_AUTO_INDEX_ON_SEARCH=true

# Characters of transcript embedded per session. bge-small's 512-token
# window is the real limit here.
SESSION_SEARCH_INDEX_MAX_TRANSCRIPT_CHARS=1500

# ==================== Server ====================

SESSION_SEARCH_SERVER_NAME=session-search
SESSION_SEARCH_LOG_LEVEL=INFO