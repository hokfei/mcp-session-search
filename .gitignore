# Virtualenvs - never commit; ~1GB each and machine-specific
.venv/
venv/
env/

# Build artifacts
build/
dist/
*.egg-info/
*.egg
wheels/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Test and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# Environment / secrets
.env
.env.local
*.pem

# Models and indexes are large, local, and reproducible from config
*.gguf
*.db
*.db-wal
*.db-shm

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log